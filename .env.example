# Copy to .env and fill in. .env is git-ignored - never commit real values.
# Variable names must match src/lms/config.py -> Settings.from_env().

# Overpass endpoint. Public mirrors are shared infrastructure; be polite.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Extra Overpass endpoints, comma separated. Tried in order after OVERPASS_URL
# when the primary returns 429/5xx or times out. Leave empty to use the built-in
# defaults (kumi.systems and maps.mail.ru).
OVERPASS_MIRRORS=

# Request timeout in seconds.
REQUEST_TIMEOUT=180

# Attempts per endpoint before moving to the next mirror. Must be >= 1.
MAX_RETRIES=3

# Base for exponential backoff in seconds (2 -> 2s, 4s, 8s ...).
# A server-sent Retry-After header always wins over this value.
BACKOFF_SECONDS=2.0

# Custom CA bundle, needed behind TLS-inspecting corporate proxies.
# REQUESTS_CA_BUNDLE takes precedence; CA_BUNDLE is the fallback name.
# Run `python -m lms.cli doctor` to verify connectivity after setting this.
REQUESTS_CA_BUNDLE=

# User agent sent with every Overpass request.
USER_AGENT=local-market-scanner/0.2 (+https://github.com/umutseve4/local-market-scanner)

# Default SQLite database path.
DB_PATH=data/market.sqlite3

# Optional second provider (not implemented yet). Use your own key.
GOOGLE_PLACES_API_KEY=
