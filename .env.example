# Copy to .env and fill in. .env is git-ignored - never commit real values.
# Variable names must match src/lms/config.py -> Settings.from_env().

# Overpass endpoint. Public mirrors are shared infrastructure; be polite.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Request timeout in seconds.
REQUEST_TIMEOUT=180

# User agent sent with every Overpass request.
USER_AGENT=local-market-scanner/0.1 (+https://github.com/umutseve4/local-market-scanner)

# Default SQLite database path.
DB_PATH=data/market.sqlite3

# Optional second provider (not implemented yet). Use your own key.
GOOGLE_PLACES_API_KEY=
